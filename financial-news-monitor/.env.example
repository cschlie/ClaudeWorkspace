# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Finnhub API key — free tier at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# NewsAPI key — required for keyword_watches (private/unlisted instruments)
# Free developer plan at https://newsapi.org/register (100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# SMTP password for the sender email account.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=your_smtp_password_here
