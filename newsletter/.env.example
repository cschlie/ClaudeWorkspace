# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=your@email.com
TO_EMAIL=your@email.com

# OpenWeatherMap (free at openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_key_here
WEATHER_CITY=London          # Your city name
WEATHER_UNITS=metric         # metric or imperial

# Finance — comma-separated tickers to track
FINANCE_TICKERS=AAPL,GOOGL,BTC-USD,ETH-USD,SPY

# Custom RSS feeds — comma-separated URLs
CUSTOM_RSS_FEEDS=https://www.theverge.com/rss/index.xml,https://feeds.feedburner.com/TechCrunch

# Schedule — 24h format, comma-separated (e.g. 7:00 AM and 5:00 PM)
SEND_TIMES=07:00,17:00
TIMEZONE=Europe/London       # Your timezone

# Optional: Google Calendar ICS URL (File > Settings > Export in Google Calendar)
GOOGLE_CALENDAR_ICS_URL=

# Newsletter branding
NEWSLETTER_NAME=My Daily Brief
